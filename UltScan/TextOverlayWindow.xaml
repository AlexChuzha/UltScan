<Window x:Class="UltScan.TextOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Полупрозрачная "карточка", чтобы текст читался -->
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CaptureColumn" Width="*"/>
            <ColumnDefinition x:Name="OutputColumn" Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="CaptureRow" Height="*"/>
            <RowDefinition x:Name="OutputRow" Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="CaptureBorder"
                Grid.Column="0"
                Grid.Row="0"
                BorderBrush="#99FFFFFF"
                BorderThickness="2"
                Background="Transparent"/>

        <Border x:Name="Card"
                Grid.Column="1"
                Grid.Row="0"
                Background="#99444444"
                CornerRadius="10"
                BorderBrush="Transparent"
                BorderThickness="0"
                Padding="4,3,8,8">
            <Grid>
                <TextBox x:Name="Editor"
                         FontSize="16"
                     FontWeight="Normal"
                         Foreground="#F2F2F2"
                         Background="Transparent"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         IsHitTestVisible="False"
                         Focusable="False"/>
                <StackPanel x:Name="TranslationPanel"
                            Visibility="Collapsed">
                    <TextBlock x:Name="OriginalTextBlock"
                               FontSize="16"
                           FontWeight="Normal"
                               Foreground="#F2F2F2"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TranslatedTextBlock"
                               Margin="0,6,0,0"
                               FontSize="16"
                           FontWeight="Normal"
                               Foreground="#4CD964"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Canvas x:Name="LayoutCanvas"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>

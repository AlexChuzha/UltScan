<Window x:Class="UltScan.TextOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">

    <Canvas x:Name="RootCanvas">
        <Path x:Name="OverlayPath"
              Fill="#99444444"
              IsHitTestVisible="False"/>

        <Border x:Name="OuterBorder"
                BorderBrush="#AA000000"
                BorderThickness="2"
                Background="Transparent"
                IsHitTestVisible="False">
            <Border x:Name="InnerBorder"
                    BorderBrush="#CCFFFFFF"
                    BorderThickness="2"
                    Margin="1"
                    Background="Transparent"/>
        </Border>

        <!-- Полупрозрачная "карточка", чтобы текст читался -->
        <Border x:Name="Card"
                Background="#99444444"
                CornerRadius="0"
                BorderBrush="Transparent"
                BorderThickness="0"
                Padding="4,3,8,8"
                IsHitTestVisible="False">
            <Grid>
                <StackPanel x:Name="EditorPanel">
                    <TextBlock x:Name="EditorStatusTextBlock"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="#B0B0B0"
                               TextWrapping="Wrap"
                               MinHeight="18"
                               Visibility="Hidden"/>
                    <TextBox x:Name="Editor"
                             FontSize="16"
                             FontWeight="Normal"
                             Foreground="#F2F2F2"
                             Background="Transparent"
                             BorderThickness="0"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             IsHitTestVisible="False"
                             Focusable="False"/>
                </StackPanel>
                <StackPanel x:Name="TranslationPanel"
                            Visibility="Collapsed">
                    <TextBlock x:Name="OriginalTextBlock"
                               FontSize="16"
                               FontWeight="Normal"
                               Foreground="#F2F2F2"
                               TextWrapping="Wrap"/>
                    <Separator x:Name="TranslationSeparator"
                               Margin="0,6,0,6"
                               Opacity="0.35"/>
                    <TextBlock x:Name="TranslationHeaderTextBlock"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="#B0B0B0"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TranslationStatusTextBlock"
                               Margin="0,2,0,0"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="#B0B0B0"
                               TextWrapping="Wrap"
                               MinHeight="18"
                               Visibility="Hidden"/>
                    <TextBlock x:Name="TranslatedTextBlock"
                               Margin="0,4,0,0"
                               FontSize="16"
                               FontWeight="Normal"
                               Foreground="#4CD964"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Canvas x:Name="LayoutCanvas"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Grid x:Name="ResizeOverlay"
              Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
              Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"
              Visibility="Collapsed"
              IsHitTestVisible="False"
              Panel.ZIndex="10">
            <Border x:Name="ResizeFrame"
                    BorderBrush="#CCFFFFFF"
                    BorderThickness="1"
                    Background="Transparent"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                </Grid.ColumnDefinitions>

                <Thumb x:Name="ResizeTopLeftThumb"
                       Grid.Row="0"
                       Grid.Column="0"
                       Width="8"
                       Height="8"
                       Background="Transparent"
                       Cursor="SizeNWSE"
                       DragStarted="ResizeThumb_DragStarted"
                       DragDelta="ResizeThumb_DragDelta"
                       DragCompleted="ResizeThumb_DragCompleted"
                       Tag="TopLeft"/>
                <Thumb x:Name="ResizeTopThumb"
                       Grid.Row="0"
                       Grid.Column="1"
                       Height="8"
                       Background="Transparent"
                       Cursor="SizeNS"
                       HorizontalAlignment="Stretch"
                       DragStarted="ResizeThumb_DragStarted"
                       DragDelta="ResizeThumb_DragDelta"
                       DragCompleted="ResizeThumb_DragCompleted"
                       Tag="Top"/>
                <Thumb x:Name="ResizeTopRightThumb"
                       Grid.Row="0"
                       Grid.Column="2"
                       Width="8"
                       Height="8"
                       Background="Transparent"
                       Cursor="SizeNESW"
                       DragStarted="ResizeThumb_DragStarted"
                       DragDelta="ResizeThumb_DragDelta"
                       DragCompleted="ResizeThumb_DragCompleted"
                       Tag="TopRight"/>
                <Thumb x:Name="ResizeLeftThumb"
                       Grid.Row="1"
                       Grid.Column="0"
                       Width="8"
                       Background="Transparent"
                       Cursor="SizeWE"
                       VerticalAlignment="Stretch"
                       DragStarted="ResizeThumb_DragStarted"
                       DragDelta="ResizeThumb_DragDelta"
                       DragCompleted="ResizeThumb_DragCompleted"
                       Tag="Left"/>
                <Thumb x:Name="ResizeRightThumb"
                       Grid.Row="1"
                       Grid.Column="2"
                       Width="8"
                       Background="Transparent"
                       Cursor="SizeWE"
                       VerticalAlignment="Stretch"
                       DragStarted="ResizeThumb_DragStarted"
                       DragDelta="ResizeThumb_DragDelta"
                       DragCompleted="ResizeThumb_DragCompleted"
                       Tag="Right"/>
                <Thumb x:Name="ResizeBottomLeftThumb"
                       Grid.Row="2"
                       Grid.Column="0"
                       Width="8"
                       Height="8"
                       Background="Transparent"
                       Cursor="SizeNESW"
                       DragStarted="ResizeThumb_DragStarted"
                       DragDelta="ResizeThumb_DragDelta"
                       DragCompleted="ResizeThumb_DragCompleted"
                       Tag="BottomLeft"/>
                <Thumb x:Name="ResizeBottomThumb"
                       Grid.Row="2"
                       Grid.Column="1"
                       Height="8"
                       Background="Transparent"
                       Cursor="SizeNS"
                       HorizontalAlignment="Stretch"
                       DragStarted="ResizeThumb_DragStarted"
                       DragDelta="ResizeThumb_DragDelta"
                       DragCompleted="ResizeThumb_DragCompleted"
                       Tag="Bottom"/>
                <Thumb x:Name="ResizeBottomRightThumb"
                       Grid.Row="2"
                       Grid.Column="2"
                       Width="8"
                       Height="8"
                       Background="Transparent"
                       Cursor="SizeNWSE"
                       DragStarted="ResizeThumb_DragStarted"
                       DragDelta="ResizeThumb_DragDelta"
                       DragCompleted="ResizeThumb_DragCompleted"
                       Tag="BottomRight"/>
            </Grid>
        </Grid>
    </Canvas>
</Window>

<Window x:Class="UltScan.TranslationSetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="860"
        Height="600"
        MinWidth="700"
        MinHeight="520"
        MaxWidth="980"
        MaxHeight="760"
        Title="Translation Setup Wizard">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   FontSize="20"
                   FontWeight="SemiBold"/>
        <TextBlock x:Name="BodyText"
                   Grid.Row="1"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#555"/>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                BorderBrush="#DADADA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid x:Name="Step1Panel">
                    <StackPanel>
                        <TextBlock x:Name="Step1TitleText"
                                   FontWeight="SemiBold"
                                   FontSize="16"/>
                        <TextBlock x:Name="Step1HintText"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#555"/>
                        <TextBlock x:Name="ProviderLabel"
                                   Margin="0,12,0,4"
                                   FontWeight="SemiBold"/>
                        <ComboBox x:Name="ProviderCombo"
                                  MinWidth="380"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="ProviderCombo_SelectionChanged"/>
                        <Border Margin="0,12,0,0"
                                Padding="10"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="#F8F8F8">
                            <TextBlock x:Name="ProviderDescriptionText"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="Step2Panel"
                      Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="Step2TitleText"
                                   FontWeight="SemiBold"
                                   FontSize="16"/>
                        <TextBlock x:Name="Step2HintText"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#555"/>
                        <Border Margin="0,10,0,0"
                                Padding="10"
                                Background="#F7F7F7"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="6">
                            <TextBlock x:Name="Step2InstructionText"
                                       TextWrapping="Wrap"
                                       Foreground="#444"/>
                        </Border>

                        <WrapPanel x:Name="Step2LinksPanel"
                                   Margin="0,12,0,0">
                            <Button x:Name="OpenEnableApiButton"
                                    MinWidth="180"
                                    Margin="0,0,8,8"
                                    Click="OpenEnableApiButton_Click"/>
                            <Button x:Name="OpenCredentialsButton"
                                    Margin="0,0,8,8"
                                    MinWidth="180"
                                    Click="OpenCredentialsButton_Click"/>
                            <Button x:Name="OpenServiceAccountsButton"
                                    Margin="0,0,8,8"
                                    MinWidth="180"
                                    Click="OpenServiceAccountsButton_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="OpenCredentialsHelpText"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#666"/>

                        <StackPanel x:Name="V2FieldsPanel"
                                    Margin="0,12,0,0">
                            <TextBlock x:Name="ApiKeyLabel"
                                       Margin="0,0,0,4"
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="ApiKeyTextBox"
                                     MinWidth="380"
                                     TextChanged="ApiKeyTextBox_TextChanged"/>
                        </StackPanel>

                        <StackPanel x:Name="V3FieldsPanel"
                                    Margin="0,12,0,0">
                            <TextBlock x:Name="ProjectIdLabel"
                                       Margin="0,0,0,4"
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="ProjectIdTextBox"
                                     MinWidth="380"
                                     TextChanged="ProjectIdTextBox_TextChanged"/>
                            <TextBlock x:Name="ServiceAccountLabel"
                                       Margin="0,10,0,4"
                                       FontWeight="SemiBold"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ServiceAccountTextBox"
                                         MinWidth="380"
                                         TextChanged="ServiceAccountTextBox_TextChanged"/>
                                <Button x:Name="BrowseServiceAccountButton"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        MinWidth="120"
                                        Click="BrowseServiceAccountButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid x:Name="Step3Panel"
                      Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="Step3TitleText"
                                   FontWeight="SemiBold"
                                   FontSize="16"/>
                        <TextBlock x:Name="Step3HintText"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="#555"/>
                        <Button x:Name="CheckButton"
                                Margin="0,12,0,0"
                                MinWidth="220"
                                HorizontalAlignment="Left"
                                Click="CheckButton_Click"/>
                        <Border Margin="0,10,0,0"
                                Background="#F7F7F7"
                                BorderBrush="#DADADA"
                                BorderThickness="1"
                                Padding="10"
                                CornerRadius="6">
                            <TextBlock x:Name="ResultText"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="#444"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StepCounterText"
                       VerticalAlignment="Center"
                       Foreground="#666"
                       FontWeight="SemiBold"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button x:Name="BackButton"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Click="BackButton_Click"/>
                <Button x:Name="NextButton"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Click="NextButton_Click"/>
                <Button x:Name="ApplyButton"
                        MinWidth="150"
                        Margin="0,0,8,0"
                        Click="ApplyButton_Click"/>
                <Button x:Name="CloseButton"
                        MinWidth="110"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

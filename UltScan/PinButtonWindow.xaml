<Window x:Class="UltScan.PinButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Width="210"
        Height="34"
        MouseEnter="Panel_MouseEnter"
        MouseLeave="Panel_MouseLeave">
    <Border x:Name="PanelRoot"
            Background="#99444444"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="8,8,0,0"
            Padding="6,4,6,6">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Thumb x:Name="DragThumb"
                   Width="22"
                   Height="24"
                   Margin="0,0,8,0"
                   Cursor="SizeAll"
                   ToolTipService.Placement="Top"
                   DragDelta="DragThumb_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Root"
                                Background="#22444444"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="2">
                            <Viewbox Width="12" Height="12"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="12" Height="12">
                                    <Path Stroke="#F2F2F2"
                                          StrokeThickness="1.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M6,1 L6,11 M1,6 L11,6"/>
                                    <Path Fill="#F2F2F2"
                                          Data="M6,0 L4.8,1.8 L7.2,1.8 Z"/>
                                    <Path Fill="#F2F2F2"
                                          Data="M6,12 L4.8,10.2 L7.2,10.2 Z"/>
                                    <Path Fill="#F2F2F2"
                                          Data="M0,6 L1.8,4.8 L1.8,7.2 Z"/>
                                    <Path Fill="#F2F2F2"
                                          Data="M12,6 L10.2,4.8 L10.2,7.2 Z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Border.Background" Value="#555C5C5C"/>
                                <Setter TargetName="Root" Property="Border.BorderBrush" Value="#AAFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Root" Property="Border.Background" Value="#883C3C3C"/>
                                <Setter TargetName="Root" Property="Border.BorderBrush" Value="#CCFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Button x:Name="ManualTranslateButton"
                    Width="24"
                    Height="24"
                    Margin="0,0,8,0"
                    FontSize="14"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.Placement="Top"
                    Click="ManualTranslateButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Foreground" Value="#F2F2F2"/>
                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                        <Setter Property="Content" Value="&#xE72C;"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root"
                                            Background="#22444444"
                                            BorderBrush="#55FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter TargetName="Root" Property="Border.Background" Value="#555C5C5C"/>
                                            <Setter TargetName="Root" Property="Border.BorderBrush" Value="#AAFFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Border.Background" Value="#883C3C3C"/>
                                            <Setter TargetName="Root" Property="Border.BorderBrush" Value="#CCFFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <CheckBox x:Name="TransparencyCheckBox"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      ToolTipService.Placement="Top"
                      Checked="TransparencyCheckBox_Checked"
                      Unchecked="TransparencyCheckBox_Unchecked"
                      Foreground="#F2F2F2"/>

            <Button x:Name="CloseButton"
                    Width="24"
                    Height="24"
                    FontSize="14"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.Placement="Top"
                    Click="CloseButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Foreground" Value="#F2F2F2"/>
                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                        <Setter Property="Content" Value="&#xE8BB;"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root"
                                            Background="#22444444"
                                            BorderBrush="#55FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter TargetName="Root" Property="Border.Background" Value="#FF3B30"/>
                                            <Setter TargetName="Root" Property="Border.BorderBrush" Value="#FF1F1F"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Border.Background" Value="#D72A24"/>
                                            <Setter TargetName="Root" Property="Border.BorderBrush" Value="#B01C18"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</Window>


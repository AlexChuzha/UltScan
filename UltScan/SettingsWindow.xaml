<Window x:Class="UltScan.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="640" Width="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HotkeysHeader"
                   FontSize="16"
                   FontWeight="SemiBold"/>

        <TextBlock x:Name="HotkeysContext"
                   Grid.Row="1"
                   Margin="0,6,0,8"
                   TextWrapping="Wrap"
                   Foreground="#555"/>

        <TextBlock x:Name="HotkeysLabel"
                   Grid.Row="2"
                   Margin="0,2,0,4"
                   FontWeight="SemiBold"/>

        <ComboBox x:Name="HotKeyCombo"
                  Grid.Row="3"
                  MinWidth="280"
                  SelectionChanged="HotKeyCombo_SelectionChanged"
                  DisplayMemberPath="DisplayName"/>

        <TextBlock x:Name="HintText"
                   Grid.Row="4"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="#444"/>

        <TextBlock x:Name="WarningText"
                   Grid.Row="5"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#B00020"
                   Visibility="Collapsed"/>

        <TextBlock x:Name="LanguageHeader"
                   Grid.Row="6"
                   Margin="0,16,0,4"
                   FontWeight="SemiBold"/>

        <ComboBox x:Name="LocaleCombo"
                  Grid.Row="7"
                  MinWidth="240"
                  SelectionChanged="LocaleCombo_SelectionChanged"
                  DisplayMemberPath="Name"/>

        <TextBlock x:Name="TranslationHeader"
                   Grid.Row="8"
                   Margin="0,16,0,4"
                   FontWeight="SemiBold"/>

        <CheckBox x:Name="TranslationEnabledCheckBox"
                  Grid.Row="9"
                  Content="Translation"
                  Checked="TranslationEnabled_Changed"
                  Unchecked="TranslationEnabled_Changed"/>

        <TextBlock x:Name="TranslationSourceLabel"
                   Grid.Row="10"
                   Margin="0,8,0,4"
                   FontWeight="SemiBold"/>

        <ComboBox x:Name="TranslationSourceCombo"
                  Grid.Row="11"
                  MinWidth="240"
                  SelectionChanged="TranslationSource_SelectionChanged"
                  DisplayMemberPath="Name"/>

        <TextBlock x:Name="TranslationTargetLabel"
                   Grid.Row="12"
                   Margin="0,8,0,4"
                   FontWeight="SemiBold"/>

        <ComboBox x:Name="TranslationTargetCombo"
                  Grid.Row="13"
                  MinWidth="240"
                  SelectionChanged="TranslationTarget_SelectionChanged"
                  DisplayMemberPath="Name"/>

        <Button x:Name="MoreLanguagesButton"
                Grid.Row="14"
                Margin="0,8,0,0"
                Width="160"
                HorizontalAlignment="Left"
                Click="MoreLanguages_Click"/>

        <TextBlock x:Name="TranslationProjectLabel"
                   Grid.Row="15"
                   Margin="0,12,0,4"
                   FontWeight="SemiBold"/>

        <TextBox x:Name="TranslationProjectTextBox"
                 Grid.Row="16"
                 MinWidth="240"
                 TextChanged="TranslationProject_Changed"/>

        <TextBlock x:Name="TranslationApiKeyWarning"
                   Grid.Row="17"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#B00020"
                   Visibility="Collapsed"/>

        <CheckBox x:Name="ExperimentalModeCheckBox"
                  Grid.Row="18"
                  Margin="0,16,0,0"
                  Content="Experimental"
                  Checked="ExperimentalMode_Changed"
                  Unchecked="ExperimentalMode_Changed"/>

        <TextBlock x:Name="ExperimentalWarningText"
                   Grid.Row="19"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#B00020"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="20"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="SaveButton"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="Save_Click"/>
            <Button x:Name="CancelButton"
                    Width="100"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="UltScan.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="420" Width="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HotkeysHeader"
                   FontSize="16"
                   FontWeight="SemiBold"/>

        <TextBlock x:Name="HotkeysContext"
                   Grid.Row="1"
                   Margin="0,6,0,8"
                   TextWrapping="Wrap"
                   Foreground="#555"/>

        <TextBlock x:Name="HotkeysLabel"
                   Grid.Row="2"
                   Margin="0,2,0,4"
                   FontWeight="SemiBold"/>

        <ComboBox x:Name="HotKeyCombo"
                  Grid.Row="3"
                  MinWidth="280"
                  SelectionChanged="HotKeyCombo_SelectionChanged"
                  DisplayMemberPath="DisplayName"/>

        <TextBlock x:Name="HintText"
                   Grid.Row="4"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="#444"/>

        <TextBlock x:Name="WarningText"
                   Grid.Row="5"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#B00020"
                   Visibility="Collapsed"/>

        <TextBlock x:Name="LanguageHeader"
                   Grid.Row="6"
                   Margin="0,16,0,4"
                   FontWeight="SemiBold"/>

        <ComboBox x:Name="LocaleCombo"
                  Grid.Row="7"
                  MinWidth="240"
                  SelectionChanged="LocaleCombo_SelectionChanged"
                  DisplayMemberPath="Name"/>

        <CheckBox x:Name="ExperimentalModeCheckBox"
                  Grid.Row="8"
                  Margin="0,16,0,0"
                  Content="Experimental"
                  Checked="ExperimentalMode_Changed"
                  Unchecked="ExperimentalMode_Changed"/>

        <TextBlock x:Name="ExperimentalWarningText"
                   Grid.Row="9"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#B00020"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="10"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="SaveButton"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="Save_Click"/>
            <Button x:Name="CancelButton"
                    Width="100"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

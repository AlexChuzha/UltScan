<Window x:Class="UltScan.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="360" Width="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Горячие клавиши"
                   FontSize="16"
                   FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,8"
                   Text="Эта комбинация запускает режим выделения области для распознавания текста."
                   TextWrapping="Wrap"
                   Foreground="#555"/>

        <TextBlock Grid.Row="2"
                   Margin="0,2,0,4"
                   Text="Выберите комбинацию:"
                   FontWeight="SemiBold"/>

        <ComboBox x:Name="HotKeyCombo"
                  Grid.Row="3"
                  MinWidth="280"
                  SelectionChanged="HotKeyCombo_SelectionChanged"
                  DisplayMemberPath="DisplayName"/>

        <TextBlock x:Name="HintText"
                   Grid.Row="4"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="#444"/>

        <TextBlock x:Name="WarningText"
                   Grid.Row="5"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="#B00020"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="6"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Сохранить"
                    Width="120"
                    Margin="0,0,8,0"
                    Click="Save_Click"/>
            <Button Content="Отмена"
                    Width="100"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
